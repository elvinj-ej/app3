{
  "name": "onprem-transformation-planner",
  "private": true,
  "version": "2.4.0",
  "description": "On-prem virtualization footprint & application disposition planner",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch --disable-warning=ExperimentalWarning server/index.ts --port 8090",
    "build": "tsc -b && vite build && vite build -c vite.server.config.ts",
    "start": "node --disable-warning=ExperimentalWarning build/server/server.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "express": "^5.3.0",
    "fflate": "^0.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "read-excel-file": "^9.3.14",
    "recharts": "^3.10.1",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "engines": {
    "node": ">=22.13"
  }
}
